<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.shidaifufen.magic2airpods5"
    android:versionCode="2"
    android:versionName="1.1">

    <permission
        android:name="com.shidaifufen.magic2airpods5.SEND_ANC"
        android:protectionLevel="signature" />
    <uses-permission android:name="com.shidaifufen.magic2airpods5.SEND_ANC" />

    <application android:label="MagicToAirPods5"
        android:description="@string/module_description"
        android:allowBackup="false"
        android:hasCode="true">

        <receiver android:name=".NoiseWidgetProvider"
            android:label="@string/widget_label"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.shidaifufen.magic2airpods5.WIDGET_CLICK" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/w_noise_info" />
        </receiver>
    </application>
</manifest>
